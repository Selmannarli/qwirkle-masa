rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  // Existing legacy app rules retained. New Renkio collections have no client access.
  match /lobbies/{roomId} {
   allow read: if true;
   allow write: if request.auth != null && request.auth.uid in request.resource.data.members;
  }
  match /rooms/{roomId} {
   allow read, write: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.members;
  }
  match /users/{uid} {
   allow read: if true;
   allow write: if request.auth != null && request.auth.uid == uid;
  }
  match /{document=**} { allow read, write: if false; }
 }
}
